# Database (Neon Postgres connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (transactional email: verification, password reset, invites)
# Leave RESEND_API_KEY empty to skip sending - verification links are then
# surfaced in the app itself and reset links are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Vantra <onboarding@resend.dev>"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Public URL of the deployment. Used to build links inside emails,
# so it must be the real deployed URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"